# Copy to .env (git-ignored) and adjust.

# Base URL of the book_review Spring Boot API (no trailing slash)
VITE_API_URL=http://localhost:8080

# GitHub link shown in the footer
VITE_LINK_GITHUB=https://github.com/your-username/book_review

# Optional — only for the disabled Open Library seeding tool (src/pages/SeederPage.jsx).
# Keep real values in your local .env; never commit them.
VITE_SEED_PAGE_PASSWORD=
VITE_SEED_ADMIN_PASSWORD=
VITE_SEED_USER_PASSWORD=
